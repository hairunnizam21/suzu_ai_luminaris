# SuzuAI Luminaris backend env. Copy to .env and fill.

# Bearer token clients must present. install.sh generates one on first run.
SUZU_TOKEN=changeme-generate-with-install-sh

# Server bind. 0.0.0.0:8765 by default — put behind a reverse proxy in prod.
SUZU_HOST=0.0.0.0
SUZU_PORT=8765

# Workspace root for chat-scoped scratch dirs (APK builds, file edits).
SUZU_WORKSPACE_ROOT=./workspace
SUZU_APK_ROOT=./apk_artifacts
SUZU_LOG_FILE=./logs/suzu.log

# Default agent iteration cap. Panel can override per session.
SUZU_DEFAULT_MAX_ITERATIONS=100
